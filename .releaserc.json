{
  "$comment": "Release notes are generated in GitHub releases and embedded in the release commit message. blocky/CHANGELOG.md is the hand-curated user-facing changelog (ADR-0010): the release verifies its section and stamps the date and compare link, never its content.",
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node scripts/changelog-release.mjs verify ${nextRelease.version}",
        "prepareCmd": "node scripts/update-addon-version.mjs ${nextRelease.version} && node scripts/changelog-release.mjs stamp ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "blocky/config.yaml",
          "blocky/CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
